+/// MEASUREMENT ONLY: logs `<epoch ms> raw <user> <system> <idle> <nice>` cumulative ticks every 250 ms.
+pub fn log_raw_ticks() {
+    std::thread::spawn(|| {
+        let host = sys::host();
+        loop {
+            if let Some(t) = cpu::read(host) {
+                eprintln!("{} raw {} {} {} {}", crate::epoch_ms(), t.0[0], t.0[1], t.0[2], t.0[3]);
+            }
+            std::thread::sleep(std::time::Duration::from_millis(250));
+        }
+    });
+}
